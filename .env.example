# Server & Application Configuration
PORT=3000
NODE_ENV=development

# Captain Security & JWT Authentication
JWT_SECRET="generate_a_cryptographically_secure_random_key"
ADMIN_PASSWORD="captain_administrator_password"

# Database Storage Path (Persistent SQLite / sql.js)
DATABASE_PATH="./data/football_club.sqlite"

# Gemini API Key (if AI Studio features are provisioned)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public App URL
APP_URL="MY_APP_URL"
